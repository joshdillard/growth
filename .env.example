# ===== Dillard AI Short Content Engine — API keys =====
# Copy to .env.local (Next.js) — scripts/daily.ts also reads the environment.

# --- Brain: research + scripts + CTA docs (required) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6   # optional override

# --- Clone: HeyGen (you have this key) ---
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=          # your clone's avatar id (GET /v2/avatars)
HEYGEN_VOICE_ID=           # your cloned voice id (GET /v2/voices)

# --- B-roll ---
RUNWAY_API_KEY=            # premium video shots (you have this key)
FAL_API_KEY=               # cheap images + video (fal.ai — recommended for volume)

# --- Google Drive/Docs: CTA funnel docs ---
# Full JSON of a service account key with Drive + Docs APIs enabled, as one line.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_MASTER_DOC_ID=      # the master index doc (share it with the service account)
BOOKING_LINK=              # your 1:1 consulting booking link (Calendly etc.)

# --- Publishing ---
# Meta (Instagram + Facebook): long-lived Page access token with
# instagram_content_publish, pages_manage_posts, instagram_manage_comments,
# pages_messaging permissions.
META_ACCESS_TOKEN=
IG_USER_ID=                # Instagram Business account id
FB_PAGE_ID=
META_WEBHOOK_VERIFY_TOKEN= # any random string; same value in Meta App Dashboard

# YouTube: OAuth2 access token with youtube.upload scope (refresh flow up to you)
YOUTUBE_ACCESS_TOKEN=

# TikTok: Content Posting API access token (requires an approved TikTok app)
TIKTOK_ACCESS_TOKEN=

# --- Hosting ---
# Public URL of this app once deployed; platforms pull the rendered MP4 from
# {PUBLIC_BASE_URL}/api/media/{reelId}/video
PUBLIC_BASE_URL=
